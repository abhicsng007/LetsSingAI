# LetsSingAI backend config.
# Copy this file to ".env" (same folder) and fill in your values.
# The backend loads agent/.env automatically on startup — no shell exports needed.
# Never commit your real .env (it holds secrets); .gitignore already excludes it.

# --- AWS credentials -------------------------------------------------------
# IAM console > Users > (your user) > Security credentials > Create access key
# > "Application running outside AWS". Paste both values below.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# --- Region where you ENABLED Bedrock model access -------------------------
# Must match the region you turned Claude on in (Bedrock > Model access).
AWS_REGION=us-west-2

# --- Bedrock model ---------------------------------------------------------
# Any Bedrock model works — change this one line, no code changes. All the
# options below support the tool-calling the coach agent needs.
#
#   Cheapest — for testing (Amazon's own models, NO usage form required):
#     us.amazon.nova-micro-v1:0    ~ $0.035 / $0.14 per M tokens (fastest, text)
#     us.amazon.nova-lite-v1:0     ~ $0.06  / $0.24 per M tokens (recommended)
#
#   Best quality — for the final demo:
#     us.anthropic.claude-3-5-haiku-20241022-v1:0   cheap Claude, strong tools
#     us.anthropic.claude-sonnet-4-20250514-v1:0    best (needs 1-time Anthropic form)
#
# Demo / recorded video — Claude (nested specialist agents-as-tools):
#   us.anthropic.claude-sonnet-4-20250514-v1:0
# Cheap path — Nova Lite (same tool names, no nested agents):
#   us.amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# Optional — Amazon Bedrock AgentCore Memory resource id. When set, session
# notes are also written to AgentCore Memory. Local JSON is always the fallback.
AGENTCORE_MEMORY_ID=
